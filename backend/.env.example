# ---------------- Core ----------------
APP_NAME="AA Car Traders API"
# development | production  (production refuses to start with the default SECRET_KEY / ADMIN_PASSWORD)
ENVIRONMENT=development
# The public address of the site (used in sitemap, WhatsApp links, ZIP details). Production: https://aacartraders.com
SITE_URL=http://localhost:8000
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------- Database ----------------
# SQLite (default, zero-config)
DATABASE_URL=sqlite:///./aa_car_traders.db
# Production alternative (Postgres):
# DATABASE_URL=postgresql://user:password@localhost:5432/aa_car_traders

# ---------------- Uploads ----------------
# Where product photos/videos are stored. Empty = backend/media. In Docker this points at a persistent volume.
MEDIA_DIR=
MAX_IMAGE_MB=12
MAX_VIDEO_MB=120

# ---------------- Admin (single account, created on first start) ----------------
# Log in at /admin/login with this email + password (any length/characters).
# Changed these later? run:  python reset_admin.py
ADMIN_EMAIL=aacartrad3rs@gmail.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME="AA Car Traders Admin"

# ---------------- WhatsApp / contact (editable later in Admin -> Settings) ----------------
WHATSAPP_NUMBER=923154448835
WHATSAPP_DEFAULT_MESSAGE="Hi AA Car Traders, I'm interested in this product:"
CONTACT_PHONE=03154448835
CONTACT_EMAIL=aacartrad3rs@gmail.com

# ---------------- AI Engine ----------------
# Main provider: groq (default) | openai | gemini
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------- Leopards Courier (delivery booking + tracking) ----------------
# Get these from your Leopards Courier merchant account: https://ep.leopardscourier.com
# Left blank, "Book with Leopards Courier" in Admin -> Orders still works — it just
# generates a MOCK-xxxxxxxxxx tracking number locally so you can test the flow
# before your real merchant account is approved.
LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=
LEOPARDS_ORIGIN_CITY=Lahore
LEOPARDS_SHIPPING_MODE=Overland

# ---------------- Misc ----------------
FRONTEND_ORIGIN=http://localhost:3000
# true only if you edit templates/JS and add new Tailwind classes without rebuilding static/css/tailwind.css
USE_TAILWIND_CDN=false
